# ─────────────────────────────────────────────────────────────────────────────
# RoofRadar AI — environment. Copy to .env and fill in. Never commit .env.
# scripts/deploy.py reads the n8n + credential values; voice-server reads the VOICE section.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n ─────────────────────────────────────────────────────────────────────
N8N_URL=https://n8n.example.com
# n8n → Settings → n8n API → Create API key
N8N_API_KEY=

# ── Postgres / Supabase (used to create the "RoofRadar Postgres" credential) ─
PGHOST=db.xxxxxxxx.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# allow | disable | require
PGSSLMODE=require

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# HTTP Basic auth that Twilio puts in the webhook URL (https://user:pass@n8n.example.com/webhook/roofradar/sms)
TWILIO_WEBHOOK_USER=twilio
TWILIO_WEBHOOK_PASSWORD=change-me-long-random

# ── Slack (bot token with chat:write, bot invited to the channels in settings) ─
SLACK_BOT_TOKEN=xoxb-...

# ── Optional integrations ───────────────────────────────────────────────────
# workflow 02 (long-lived Page token with leads_retrieval)
META_PAGE_ACCESS_TOKEN=
# workflow 12 (private app token, crm.objects.contacts/deals write)
HUBSPOT_APP_TOKEN=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# ── Shared secret between voice-server and n8n workflow 24A/24B ────────────
VOICE_GATEWAY_KEY=change-me-long-random

# ── Existing credential ids (skip auto-creation; required for Google Calendar) ─
# Create "RoofRadar Google Calendar" (Google Calendar OAuth2 API) in the n8n UI, then paste its id
# (the last part of the credential URL) here.
CRED_GCAL_ID=
# CRED_POSTGRES_ID=  CRED_OPENAI_ID=  CRED_TWILIO_ID=  CRED_SLACK_ID=  CRED_META_ID=
# CRED_HUBSPOT_ID=   CRED_SMTP_ID=    CRED_N8N_API_ID=  CRED_VOICE_KEY_ID=  CRED_TWILIO_HOOK_ID=

# ═════════════════════════════ VOICE SERVER ═════════════════════════════════
PORT=8080
# host Twilio reaches over HTTPS/WSS, no scheme
PUBLIC_HOST=voice.example.com
VALIDATE_TWILIO_SIGNATURE=true
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres?sslmode=require
# low latency matters more than depth on a phone call
OPENAI_VOICE_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
N8N_VOICE_TOOL_URL=https://n8n.example.com/webhook/roofradar/voice-tool
N8N_VOICE_CALL_ENDED_URL=https://n8n.example.com/webhook/roofradar/voice-call-ended
N8N_VOICE_TRANSFER_RESULT_URL=https://twilio:change-me-long-random@n8n.example.com/webhook/roofradar/voice-transfer-result
VOICE_LANGUAGE=en-US
# optional: ElevenLabs | Google | Amazon
TTS_PROVIDER=
TTS_VOICE=
# optional: Deepgram | Google
STT_PROVIDER=
MAX_CALL_MINUTES=15
