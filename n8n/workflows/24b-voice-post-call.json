          },
          "conditions": [
            {
              "id": "5eea544f-5434-4665-b870-56614c754999",
              "leftValue": "={{ !!$json.transcript && !!$json.lead_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
