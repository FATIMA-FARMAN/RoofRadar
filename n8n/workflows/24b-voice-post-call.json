      "id": "d6059b81-3cae-43fc-b69c-4180ead03c1d",
      "name": "HAS_TRANSCRIPT?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "function fill(t, vars) { return t.replace(/\\{(\\w+)\\}/g, (m, k) => (vars[k] ?? m)); }\nfunction buildOpenAI(model, system, userObj, maxTokens) {\n  const req = {\n    model,\n    messages: [\n      { role: 'system', content: system },\n      { role: 'user', content: typeof userObj === 'string' ? userObj : JSON.stringify(userObj) }\n    ],\n    response_format: { type: 'json_object' },\n    max_completion_tokens: maxTokens || 1500\n  };\n  // GPT-5 family / o-series are reasoning models: keep reasoning light for chat latency\n  if (/^(gpt-5|o\\d)/.test(model)) req.reasoning_effort = 'low';\n  return req;\n}\nconst P = \"Summarise this phone call between a caller and the {company} voice assistant.\\nReturn JSON only:\\n{\\\"summary\\\": \\\"1-2 sentences\\\", \\\"problem_type\\\": string|null, \\\"urgency\\\": \\\"LOW\\\"|\\\"MEDIUM\\\"|\\\"HIGH\\\"|\\\"EMERGENCY\\\"|\\\"UNKNOWN\\\",\\n  \\\"appointment_booked\\\": boolean, \\\"human_handoff\\\": boolean, \\\"followup_required\\\": boolean,\\n  \\\"followup_reason\\\": string|null, \\\"caller_name\\\": string|null, \\\"address\\\": string|null,\\n  \\\"outcome\\\": \\\"BOOKED\\\"|\\\"QUALIFIED\\\"|\\\"HANDOFF\\\"|\\\"INFO\\\"|\\\"ABANDONED\\\"|\\\"OPTED_OUT\\\"}\\nOnly report appointment_booked=true if a TOOL line in the transcript shows booked=true.\";\n\nconst s = $json;\nreturn [{ json: { openai_request: buildOpenAI(s.org_settings?.ai?.models?.summary || 'gpt-5.4-mini',\n  fill(P, { company: s.org_name }), { transcript: String(s.transcript).slice(-24000) }, 1500) } }];"
      },
      "id": "96bcb2e6-76a5-4c58-9813-ed7de58c43ce",
      "name": "PREP_SUMMARY",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "options": {
          "timeout": 20000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.openai_request) }}"
      },
      "id": "b6030a39-732f-46cd-a4fa-385f0a00927c",
      "name": "AI_SUMMARY",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "__CRED_OPENAI_ID__",
          "name": "RoofRadar OpenAI"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nconst content = r.choices?.[0]?.message?.content || '';\nlet parsed = null, parse_error = null;\ntry { parsed = JSON.parse(content); }\ncatch (e) {\n  const m = content.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { parsed = JSON.parse(m[0]); } catch (e2) { parse_error = e2.message; } }\n  else parse_error = e.message || 'empty response';\n}\nreturn [{ json: {\n  parsed, parse_error, raw: content,\n  model: r.model || null,\n  prompt_tokens: r.usage?.prompt_tokens ?? null,\n  completion_tokens: r.usage?.completion_tokens ?? null\n}}];"
      },
      "id": "d6439b0b-bd2f-4bba-8d57-062cb225c62f",
      "name": "PARSE_JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $json.parsed || {};\nconst s = $('SAVE_TRANSCRIPT').first().json;\nconst pick = (v, l, d) => l.includes(v) ? v : d;\n// never trust the model on booking: check the transcript for a tool result\nconst toolBooked = /TOOL: .*\"booked\":\\s*true/.test(s.transcript || '');\nconst toolHandoff = /TOOL: .*\"handoff\":\\s*true|TOOL: .*\"transfer\":\\s*true/.test(s.transcript || '');\nconst outcome = toolBooked ? 'BOOKED' : toolHandoff ? 'HANDOFF'\n  : pick(String(o.outcome || '').toUpperCase(), ['QUALIFIED','INFO','ABANDONED','OPTED_OUT'], 'INFO');\nreturn [{ json: {\n  summary: typeof o.summary === 'string' ? o.summary.slice(0, 600) : null,\n  problem_type: typeof o.problem_type === 'string' ? o.problem_type.slice(0, 120) : null,\n  urgency: pick(String(o.urgency || '').toUpperCase(), ['LOW','MEDIUM','HIGH','EMERGENCY'], null),\n  caller_name: typeof o.caller_name === 'string' ? o.caller_name.slice(0, 120) : null,\n  address: typeof o.address === 'string' ? o.address.slice(0, 200) : null,\n  appointment_booked: toolBooked, human_handoff: toolHandoff,\n  followup_required: !toolBooked && !toolHandoff && outcome !== 'OPTED_OUT' && o.followup_required !== false,\n  followup_reason: o.followup_reason || null, outcome\n}}];"
      },
      "id": "66eb95a7-9ea7-4c19-abe3-68d38210123e",
      "name": "VALIDATE_SUMMARY",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
