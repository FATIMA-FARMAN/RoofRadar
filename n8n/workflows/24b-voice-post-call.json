        "options": {
          "queryReplacement": "={{ [ $('SAVE_TRANSCRIPT').first().json.lead_id, $('VALIDATE_SUMMARY').first().json.caller_name || '', $('VALIDATE_SUMMARY').first().json.address || '', $('VALIDATE_SUMMARY').first().json.problem_type || '', $('VALIDATE_SUMMARY').first().json.urgency || '', $('VALIDATE_SUMMARY').first().json.summary || '' ] }}"
