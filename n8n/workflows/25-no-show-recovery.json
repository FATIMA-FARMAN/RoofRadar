      "id": "01f7ec7d-b5f4-4e23-87b0-4f2bbae2b529",
      "name": "SCHEDULE_TRIGGER",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id AS appointment_id, a.lead_id, a.organization_id\nFROM appointments a\nJOIN leads l ON l.id = a.lead_id\nJOIN organizations o ON o.id = a.organization_id\nWHERE a.status = 'NO_SHOW'\n  AND a.no_show_recovery_sent_at IS NULL\n  AND a.start_at > NOW() - INTERVAL '7 days'                      -- don't text about old misses\n  AND o.active AND l.phone IS NOT NULL AND NOT l.human_handoff\n  AND l.status NOT IN ('STOPPED','LOST','WON','DISQUALIFIED')\n  AND rr_can_contact(l.id, 'sms')\n  AND extract(hour FROM NOW() AT TIME ZONE o.timezone) BETWEEN 9 AND 19   -- quiet hours: 9:00–19:59 local\n  AND NOT EXISTS (SELECT 1 FROM appointments b WHERE b.lead_id = a.lead_id\n                  AND b.status IN ('SCHEDULED','CONFIRMED') AND b.start_at > NOW())  -- already rebooked\nORDER BY a.start_at\nLIMIT 10;",
        "options": {}
      },
      "id": "786fd9db-24a9-4694-8f76-2a54bf3cbca0",
      "name": "FIND_NO_SHOWS",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c8689f56-ced7-4938-8491-b88e0992624b",
              "leftValue": "={{ $json.appointment_id !== undefined && $json.appointment_id !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9deb4653-009d-4e71-892b-204cd21360cd",
      "name": "FIND_NO_SHOWS_HAS_ROWS",
      "type": "n8n-nodes-base.filter",
