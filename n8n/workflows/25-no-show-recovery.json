    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  UPDATE appointments SET no_show_recovery_sent_at = NOW()\n  WHERE id = $1::uuid AND no_show_recovery_sent_at IS NULL\n  RETURNING id AS appointment_id, lead_id, organization_id\n), l AS (   -- let the lead book again\n  UPDATE leads SET status = CASE WHEN status = 'BOOKED' THEN 'ENGAGED' ELSE status END\n  WHERE id = (SELECT lead_id FROM a) RETURNING id\n)\nSELECT a.* FROM a;",
        "options": {
          "queryReplacement": "={{ [ $json.appointment_id ] }}"
        }
      },
      "id": "8924b328-f102-4578-9c9c-bebd8f9aefc2",
