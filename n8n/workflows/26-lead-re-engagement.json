    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activities (organization_id, lead_id, type, description, metadata)\nVALUES ($1::uuid, $2::uuid, 'REENGAGEMENT', 'Check-in text to quiet lead', $3::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('CLAIM_LEAD').item.json.organization_id, $('CLAIM_LEAD').item.json.lead_id, JSON.stringify({sent: $json.sent === true}) ] }}"
        }
