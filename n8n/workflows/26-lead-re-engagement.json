{
  "name": "RR 26 · Lead Re-engagement",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * *"
            }
          ]
        }
      },
      "id": "1703cf69-43a6-45f3-ae29-a1914ad75e1c",
      "name": "SCHEDULE_TRIGGER",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.id AS lead_id, l.organization_id\nFROM leads l\nJOIN organizations o ON o.id = l.organization_id\nWHERE o.active\n  AND coalesce((o.settings->'reengagement'->>'enabled')::boolean, true)\n  AND l.status IN ('CONTACTED','ENGAGED','QUALIFIED')\n  AND NOT l.human_handoff AND l.phone IS NOT NULL\n  AND coalesce(l.last_message_at, l.created_at) < NOW() - INTERVAL '30 days'\n  AND coalesce(l.last_message_at, l.created_at) > NOW() - INTERVAL '180 days'\n  AND (l.metadata->>'reengaged_at' IS NULL OR (l.metadata->>'reengaged_at')::timestamptz < NOW() - INTERVAL '90 days')\n  AND NOT EXISTS (SELECT 1 FROM followups f WHERE f.lead_id = l.id AND f.status = 'PENDING')\n  AND NOT EXISTS (SELECT 1 FROM appointments a WHERE a.lead_id = l.id\n                  AND a.status IN ('SCHEDULED','CONFIRMED') AND a.start_at > NOW())\n  AND rr_can_contact(l.id, 'sms')\nORDER BY l.lead_score DESC\nLIMIT 20;",
        "options": {}
      },
      "id": "940f6813-6740-473a-ace0-482d6331454b",
      "name": "FIND_QUIET_LEADS",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4648951d-546d-4a3a-9a69-453b3c9cec1f",
              "leftValue": "={{ $json.lead_id !== undefined && $json.lead_id !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0f6ac55-e944-4118-a3da-869abc6d945a",
      "name": "FIND_QUIET_LEADS_HAS_ROWS",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET metadata = metadata || jsonb_build_object('reengaged_at', NOW())\nWHERE id = $1::uuid\n  AND (metadata->>'reengaged_at' IS NULL OR (metadata->>'reengaged_at')::timestamptz < NOW() - INTERVAL '90 days')\nRETURNING id AS lead_id, organization_id;",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id ] }}"
        }
      },
      "id": "304c1de3-fb42-42ef-a81b-1cf0c744ba5b",
