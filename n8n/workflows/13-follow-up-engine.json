      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups SET\n  status = CASE WHEN $2::boolean THEN 'SENT' ELSE 'FAILED' END,\n  skip_reason = CASE WHEN $2::boolean THEN NULL ELSE $3::text END\nWHERE id = $1::uuid\nRETURNING id, lead_id, status;",
        "options": {
          "queryReplacement": "={{ [ $('CLAIM_FOLLOWUP').item.json.followup_id, $json.sent === true, $json.reason || $json.error || 'send_failed' ] }}"
        }
      },
      "id": "0eb0a487-3919-472f-8daa-8f4daace6d95",
      "name": "UPDATE_FOLLOWUP",
