    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activities (organization_id, lead_id, type, description, metadata)\nSELECT organization_id, id, 'FOLLOWUP_' || $2::text, 'Follow-up step ' || $3::text, '{}'::jsonb FROM leads WHERE id = $1::uuid\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id, $json.status, $('CLAIM_FOLLOWUP').item.json.step ] }}"
