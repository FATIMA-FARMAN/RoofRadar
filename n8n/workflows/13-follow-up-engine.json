    {
      "parameters": {
        "jsCode": "const f = $json;\nreturn { json: { lead_id: f.lead_id, organization_id: $('CHECK_STATUS').item.json.organization_id,\n  channel: $('CHECK_STATUS').item.json.preferred_channel === 'whatsapp' ? 'whatsapp' : 'sms',\n  mode: 'FOLLOWUP', step: f.step } };",
        "mode": "runOnceForEachItem"
      },
