{
  "name": "RR 13 · Follow-up Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "7a8ffa9a-936a-431b-b9b5-29e198ceae74",
      "name": "SCHEDULE_TRIGGER",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT f.id AS followup_id, f.step, f.type, f.lead_id, f.created_at AS followup_created_at,\n       l.status, l.human_handoff, l.last_inbound_at, l.organization_id, l.preferred_channel,\n       o.timezone, rr_can_contact(l.id, 'sms') AS can_contact, (l.phone IS NOT NULL) AS has_phone\nFROM followups f\nJOIN leads l ON l.id = f.lead_id\nJOIN organizations o ON o.id = l.organization_id\nWHERE f.status = 'PENDING' AND f.due_at <= NOW() AND f.type IN ('NURTURE','MISSED_CALL')\nORDER BY f.due_at\nLIMIT 25;",
        "options": {}
      },
      "id": "6aa122bf-8f41-48f9-b617-0d7f38fe1ee2",
      "name": "FIND_FOLLOWUPS_DUE",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        500,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $json;\nconst stopStatuses = ['BOOKED','HUMAN_HANDOFF','STOPPED','DISQUALIFIED','WON','LOST'];\nlet decision = 'SEND', reason = null, defer_until = null;\nif (stopStatuses.includes(r.status) || r.human_handoff) { decision = 'SKIP'; reason = 'status_' + (r.human_handoff ? 'HUMAN' : r.status); }\nelse if (!r.can_contact) { decision = 'SKIP'; reason = 'no_consent'; }\nelse if (!r.has_phone) { decision = 'SKIP'; reason = 'no_phone'; }\nelse if (r.last_inbound_at && new Date(r.last_inbound_at) > new Date(r.followup_created_at)) { decision = 'SKIP'; reason = 'customer_replied'; }\nelse {\n  // quiet hours: only text 9:00–20:00 in the company timezone\n  const now = DateTime.now().setZone(r.timezone || 'America/New_York');\n  if (now.hour < 9 || now.hour >= 20) {\n    decision = 'DEFER';\n    const next = now.hour >= 20 ? now.plus({ days: 1 }) : now;\n    defer_until = next.set({ hour: 9, minute: 5, second: 0, millisecond: 0 }).toUTC().toISO();\n  }\n}\nreturn { json: { ...r, decision, reason, defer_until } };",
        "mode": "runOnceForEachItem"
      },
      "id": "b4b993f6-fd10-4d8e-ae51-36eda9546a5e",
      "name": "CHECK_STATUS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "9428d965-3250-41ea-9c39-e838490f349a",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "SEND",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "SEND"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "77eb892f-0026-488b-a647-801bcc8521c9",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "DEFER",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "DEFER"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "ea0886f8-6abf-4c11-93fa-111b76bb738c",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "SKIP",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "SKIP"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "OTHER"
        }
      },
      "id": "62e25e20-c26e-4e56-99b9-76e54570fd2d",
      "name": "ROUTE_DECISION",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups SET status='SKIPPED', skip_reason=$2::text WHERE id=$1::uuid RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.followup_id, $json.reason ] }}"
        }
      },
      "id": "873ea825-9bd9-4790-9b7a-8b9c84524058",
      "name": "MARK_SKIPPED",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1280,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE followups SET due_at=$2::timestamptz WHERE id=$1::uuid AND status='PENDING' RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.followup_id, $json.defer_until ] }}"
