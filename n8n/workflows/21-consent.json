      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const t = $('EXECUTE_WORKFLOW_TRIGGER').first().json;\nconst channel = t.channel === 'voice' ? 'all' : (t.channel || 'sms');\nreturn [{ json: { lead_id: t.lead_id, channel, text: String(t.body || '').trim(), action: t.action || null, source: t.source || 'unknown' } }];"
      },
      "id": "fdf2f404-10f7-4b7f-97a0-b6f26be12ddb",
      "name": "NORMALIZE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE\n         WHEN $2::text = 'OPT_OUT' OR rr_is_opt_out($1::text) THEN 'OPT_OUT'\n         WHEN $2::text = 'OPT_IN'  OR rr_is_opt_in($1::text)  THEN 'OPT_IN'\n         ELSE 'NONE'\n       END AS consent_action;",
        "options": {
          "queryReplacement": "={{ [ $json.text, $json.action || '' ] }}"
        }
      },
      "id": "1c4d8057-4f9a-4c8d-b891-d22b27d11e39",
      "name": "CLASSIFY",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        760,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO consents (lead_id, channel, consent_status, source, metadata)\nSELECT $1::uuid, $2::text, CASE WHEN $3::text = 'OPT_OUT' THEN 'OPTED_OUT' ELSE 'OPTED_IN' END, $4::text,\n       jsonb_build_object('text', $5::text)\nWHERE $3::text IN ('OPT_OUT','OPT_IN')\nRETURNING id, consent_status, $3::text AS consent_action;",
        "options": {
          "queryReplacement": "={{ [ $('NORMALIZE').first().json.lead_id, $('NORMALIZE').first().json.channel, $json.consent_action, $('NORMALIZE').first().json.source, $('NORMALIZE').first().json.text ] }}"
        }
      },
