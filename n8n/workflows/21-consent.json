      "id": "9ceea931-24dc-40ee-b2ad-f6ac16e0565e",
      "name": "STOP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (UPDATE leads SET status = 'STOPPED' WHERE id = $1::uuid RETURNING organization_id),\n     c AS (UPDATE conversations SET ai_active = false WHERE lead_id = $1::uuid AND status = 'ACTIVE' RETURNING id),\n     f AS (UPDATE followups SET status = 'CANCELLED', skip_reason = 'OPTED_OUT' WHERE lead_id = $1::uuid AND status = 'PENDING' RETURNING id)\nSELECT rr_log_event((SELECT organization_id FROM l), $1::uuid, '21_CONSENT', 'OPTED_OUT',\n       jsonb_build_object('source', $2::text, 'paused_conversations', (SELECT count(*) FROM c), 'cancelled_followups', (SELECT count(*) FROM f))) AS event_id,\n       'OPTED_OUT' AS consent_status, true AS stopped;",
        "options": {
          "queryReplacement": "={{ [ $('NORMALIZE').first().json.lead_id, $('NORMALIZE').first().json.source ] }}"
        }
      },
      "id": "1a5b6c8f-9bd5-4fd8-9b0d-5115186444a8",
      "name": "DISABLE_AI_OUTREACH",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (\n  UPDATE leads SET status = CASE WHEN status = 'STOPPED' THEN 'CONTACTED' ELSE status END\n  WHERE id = $1::uuid AND $2::text = 'OPT_IN' RETURNING organization_id\n), c AS (\n  UPDATE conversations SET ai_active = true\n  WHERE lead_id = $1::uuid AND status = 'ACTIVE' AND $2::text = 'OPT_IN'\n    AND NOT EXISTS (SELECT 1 FROM leads WHERE id = $1::uuid AND human_handoff) RETURNING id\n)\nSELECT rr_log_event((SELECT organization_id FROM leads WHERE id = $1::uuid), $1::uuid, '21_CONSENT', 'CONSENT_' || $2::text,\n       jsonb_build_object('reactivated', (SELECT count(*) FROM l), 'ai_resumed', (SELECT count(*) FROM c))) AS event_id,\n       $2::text AS consent_status, false AS stopped;",
        "options": {
          "queryReplacement": "={{ [ $('NORMALIZE').first().json.lead_id, $('CLASSIFY').first().json.consent_action ] }}"
        }
      },
      "id": "05e2c6bd-b539-4f9a-8ce4-4e70496c1ed7",
      "name": "LOG_CONSENT",
      "type": "n8n-nodes-base.postgres",
