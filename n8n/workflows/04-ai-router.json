    {
      "parameters": {
        "jsCode": "function fill(t, vars) { return t.replace(/\\{(\\w+)\\}/g, (m, k) => (vars[k] ?? m)); }\nfunction buildOpenAI(model, system, userObj, maxTokens) {\n  const req = {\n    model,\n    messages: [\n      { role: 'system', content: system },\n      { role: 'user', content: typeof userObj === 'string' ? userObj : JSON.stringify(userObj) }\n    ],\n    response_format: { type: 'json_object' },\n    max_completion_tokens: maxTokens || 1500\n  };\n  // GPT-5 family / o-series are reasoning models: keep reasoning light for chat latency\n  if (/^(gpt-5|o\\d)/.test(model)) req.reasoning_effort = 'low';\n  return req;\n}\nconst ROUTER = \"You are the routing agent for {company}, a roofing company.\\nDecide the single next action for the customer's LATEST message, using the conversation history and context JSON.\\n\\nAllowed actions:\\nANSWER      \\u2013 ordinary question answerable from the approved company info (services, service area, FAQ).\\nQUALIFY     \\u2013 we still need basic facts (what the problem is, where the property is, how urgent) and the customer is engaged.\\nBOOK        \\u2013 clear intent to schedule an inspection/appointment, or the customer is choosing one of the offered_slots.\\nRESCHEDULE  \\u2013 the customer has an existing appointment (context.lead.upcoming_appointment) and wants to change or cancel it.\\nHUMAN       \\u2013 explicit request for a person; complaint; legal issue; refund; insurance dispute; pricing negotiation or\\n              a request for a price/quote; safety concern; anything unsupported; or you are not confident.\\nSTOP        \\u2013 STOP, unsubscribe, stop messaging, do not contact me, remove me.\\nEMERGENCY   \\u2013 ONLY when one of context.company.emergency_criteria is clearly and currently true. Copy the matching\\n              criterion text exactly into \\\"emergency_criteria_matched\\\". Otherwise never use EMERGENCY.\\n\\nSlot selection:\\n- If the customer picks one of context.offered_slots (by number, day, or time), set action BOOK (or RESCHEDULE when\\n  they already have an appointment) and copy that slot's \\\"iso\\\" value EXACTLY into \\\"selected_slot\\\".\\n- If they want a time that is not in offered_slots, set selected_slot null and fill preferred_date (YYYY-MM-DD, in the\\n  company timezone) and/or preferred_time (HH:MM 24h) when stated.\\n\\nNever invent availability. Never invent prices. Never create appointments. Never claim anything is booked.\\n\\nAlso rate the customer's mood in the LATEST message as \\\"sentiment\\\": POSITIVE | NEUTRAL | NEGATIVE | ANGRY.\\nANGRY = hostile, threatening, swearing at us, or a clear complaint about our service.\\n\\nReturn JSON only, exactly this shape:\\n{\\\"action\\\": \\\"...\\\", \\\"confidence\\\": 0.0-1.0, \\\"reason\\\": \\\"short why\\\", \\\"sentiment\\\": \\\"NEUTRAL\\\",\\n  \\\"selected_slot\\\": null, \\\"preferred_date\\\": null, \\\"preferred_time\\\": null,\\n  \\\"emergency_criteria_matched\\\": null, \\\"handoff_reason\\\": null}\";\n\nconst t = $('EXECUTE_WORKFLOW_TRIGGER').first().json;\nconst ctx = $('GET_LEAD').first().json;\nconst org = $('GET_COMPANY_RULES').first().json;\nconst s = org.settings || {};\nconst lead = ctx.lead;\nconst tz = org.timezone || 'America/New_York';\nconst fmt = iso => DateTime.fromISO(String(iso)).setZone(tz).toFormat(\"ccc LLL d, h:mm a\");\nconst offered = (lead.metadata && lead.metadata.offered_slots) || [];\nconst user = {\n  now_local: DateTime.now().setZone(tz).toFormat(\"cccc yyyy-LL-dd HH:mm ZZZZ\"),\n  company: {\n    name: org.name, services: s.services, service_area: s.service_area?.description,\n    faq: s.faq || {}, emergency_criteria: s.emergency_criteria || []\n  },\n  lead: {\n    name: lead.name, status: lead.status, qualification_status: lead.qualification_status,\n    problem_type: lead.problem_type, urgency: lead.urgency, lead_score: lead.lead_score,\n    upcoming_appointment: ctx.upcoming_appointment ? { start_local: fmt(ctx.upcoming_appointment.start_at) } : null\n  },\n  offered_slots: offered.map(o => ({ iso: o.iso, label: o.label })),\n  history: $('GET_RECENT_MESSAGES').first().json.history || [],\n  latest_message: t.body\n};\nconst model = s.ai?.models?.router || 'gpt-5.4-mini';\nreturn [{ json: { openai_request: buildOpenAI(model, fill(ROUTER, { company: org.name }), user, 1500) } }];"
      },
