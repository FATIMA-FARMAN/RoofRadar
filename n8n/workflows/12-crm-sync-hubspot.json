    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (UPDATE leads SET crm_contact_id = $2::text WHERE id = $1::uuid RETURNING organization_id),\n     d AS (UPDATE deals SET crm_deal_id = COALESCE(crm_deal_id, NULLIF($4::text,'')) WHERE id = NULLIF($3::text,'')::uuid RETURNING id)\nINSERT INTO activities (organization_id, lead_id, type, description, metadata)\nSELECT organization_id, $1::uuid, 'CRM_SYNC', 'HubSpot contact/deal upserted',\n       jsonb_build_object('contact_id', $2::text, 'deal_id', NULLIF($4::text,''))\nFROM l RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('MAP_CRM_FIELDS').first().json.lead_id, $('CONTACT_ID').first().json.contact_id, $('MAP_CRM_FIELDS').first().json.deal_id || '', ($json.id ? String($json.id) : ($('MAP_CRM_FIELDS').first().json.crm_deal_id || '')) ] }}"
        }
      },
