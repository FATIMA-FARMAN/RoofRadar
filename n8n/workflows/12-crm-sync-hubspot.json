    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT to_jsonb(l.*) AS lead, o.settings->'crm' AS crm, o.timezone,\n       (SELECT to_jsonb(d.*) FROM deals d WHERE d.lead_id = l.id ORDER BY d.created_at DESC LIMIT 1) AS deal,\n       (SELECT to_jsonb(a.*) FROM appointments a WHERE a.lead_id = l.id AND a.status IN ('SCHEDULED','CONFIRMED')\n         ORDER BY a.start_at LIMIT 1) AS appointment\nFROM leads l JOIN organizations o ON o.id = l.organization_id\nWHERE l.id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('EXECUTE_WORKFLOW_TRIGGER').first().json.lead_id ] }}"
        }
      },
