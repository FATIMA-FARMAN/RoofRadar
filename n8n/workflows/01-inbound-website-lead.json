    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (organization_id, name, phone, email, address, source, problem_type,\n                   first_message, external_id, status, preferred_channel)\nVALUES ($1::uuid, NULLIF($2::text,''), NULLIF($3::text,''), NULLIF($4::text,''), NULLIF($5::text,''),\n        $6::text, NULLIF($7::text,''), NULLIF($8::text,''), NULLIF($9::text,''), 'NEW', 'sms')\nON CONFLICT (organization_id, phone) WHERE phone IS NOT NULL\nDO UPDATE SET updated_at = NOW()\nRETURNING *, (xmax = 0) AS is_new;",
        "options": {
          "queryReplacement": "={{ [ $('RESOLVE_ORG').item.json.id, $('NORMALIZE_LEAD').item.json.name, $('NORMALIZE_LEAD').item.json.phone_e164, $('NORMALIZE_LEAD').item.json.email, $('NORMALIZE_LEAD').item.json.address, 'website', $('NORMALIZE_LEAD').item.json.problem_type, $('NORMALIZE_LEAD').item.json.message, $('NORMALIZE_LEAD').item.json.external_id ] }}"
