        "query": "SELECT *\nFROM leads\nWHERE organization_id = $1::uuid\n  AND (\n        phone = $2::text\n     OR ($3::text IS NOT NULL AND lower(email) = lower($3::text))\n     OR ($4::text IS NOT NULL AND external_id = $4::text)\n  )\nORDER BY (phone = $2::text) DESC NULLS LAST, created_at\nLIMIT 1;",
