      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1590be54-3b57-4b42-97c4-4cf0bf23baa5",
              "leftValue": "={{ $('CHECK_STATUS').first().json.missed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
