        "operation": "executeQuery",
        "query": "UPDATE activities SET description = 'Missed call — text-back sent', metadata = metadata || jsonb_build_object('sms_sent', $2::boolean)\nWHERE id = $1::uuid RETURNING id;",
        "options": {
