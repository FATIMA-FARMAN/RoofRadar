        },
        "options": {}
      },
      "id": "672f546f-f187-42d0-8b88-b527d14baff4",
      "name": "MISSED?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activities (organization_id, type, description, metadata)\nVALUES ($1::uuid, 'CALL', $2::text, $3::jsonb) RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.id, 'Call ' + $('CHECK_STATUS').first().json.status, JSON.stringify({call_sid: $('CHECK_STATUS').first().json.call_sid, from: $('CHECK_STATUS').first().json.phone_e164, duration: $('CHECK_STATUS').first().json.duration}) ] }}"
        }
      },
      "id": "366ac996-e39e-4200-82e0-89e463f98310",
      "name": "LOG_CALL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "__CRED_POSTGRES_ID__",
          "name": "RoofRadar Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (\n  INSERT INTO leads (organization_id, phone, source, status)\n  VALUES ($1::uuid, $2::text, 'missed_call', 'NEW')\n  ON CONFLICT (organization_id, phone) WHERE phone IS NOT NULL DO UPDATE SET updated_at = NOW()\n  RETURNING *\n), claim AS (   -- claim the CallSid first: a duplicate Twilio callback can never text twice\n  INSERT INTO activities (organization_id, lead_id, type, description, metadata)\n  SELECT l.organization_id, l.id, 'MISSED_CALL', 'Missed call', jsonb_build_object('call_sid', $3::text, 'status', $4::text)\n  FROM l\n  ON CONFLICT ((metadata->>'call_sid')) WHERE type = 'MISSED_CALL' DO NOTHING\n  RETURNING id\n)\nSELECT l.id AS lead_id, l.name, l.status, l.organization_id, (SELECT id FROM claim) AS activity_id,\n       NOT EXISTS (SELECT 1 FROM claim) AS already_handled,\n       -- rr_can_contact() can't see a row inserted by this same statement, so check the CTE row directly\n       (l.status NOT IN ('STOPPED','BOOKED','HUMAN_HANDOFF') AND COALESCE((SELECT c.consent_status <> 'OPTED_OUT' FROM consents c\n                  WHERE c.lead_id = l.id AND c.channel IN ('sms','all') ORDER BY c.captured_at DESC LIMIT 1), true)) AS can_contact\nFROM l;",
        "options": {
          "queryReplacement": "={{ [ $('RESOLVE_ORG').first().json.id, $('CHECK_STATUS').first().json.phone_e164, $('CHECK_STATUS').first().json.call_sid, $('CHECK_STATUS').first().json.status ] }}"
        }
      },
      "id": "cb7cf514-248b-4f42-b684-8998c406e68b",
      "name": "FIND_LEAD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
