    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ ($json.body.DialCallStatus && $json.body.DialCallStatus !== 'completed') ? '<Response><Say>Sorry we missed your call. We will text you right away.</Say><Hangup/></Response>' : '<Response></Response>' }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "id": "1325a5d3-c967-4d7f-96ad-5b445cf993a6",
      "name": "RESPOND_TWIML",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// E.164 normaliser. Assumes US/Canada (+1) when a bare 10/11-digit number arrives.\nfunction normalizePhone(phone) {\n  if (!phone) return null;\n  let p = String(phone).trim().replace(/^whatsapp:/i, '').replace(/[^\\d+]/g, '');\n  if (p.startsWith('00')) p = '+' + p.substring(2);\n  if (!p.startsWith('+') && p.length === 10) p = '+1' + p;\n  if (!p.startsWith('+') && p.length === 11 && p.startsWith('1')) p = '+' + p;\n  return /^\\+[1-9]\\d{7,14}$/.test(p) ? p : null;\n}\n\nconst b = $json.body ?? $json;\nconst status = String(b.DialCallStatus || b.CallStatus || '').toLowerCase();\nreturn [{ json: {\n  call_sid: b.CallSid, phone_e164: normalizePhone(b.From), business_phone: normalizePhone(b.To),\n  status, direction: b.Direction || 'inbound', duration: Number(b.CallDuration || b.DialCallDuration || 0)\n}}];"
      },
      "id": "f01e0661-c157-4cdf-a0f7-51a7818d58ac",
      "name": "NORMALIZE_CALL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const missedStates = ['no-answer', 'busy', 'failed', 'canceled'];\nconst inbound = String($json.direction).startsWith('inbound');\nreturn [{ json: { ...$json, missed: inbound && missedStates.includes($json.status) && !!$json.phone_e164 } }];"
      },
      "id": "9208bfa3-3b49-4706-99bd-9f62e161fa0b",
      "name": "CHECK_STATUS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, settings FROM organizations WHERE business_phone = $1::text AND active LIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.business_phone ] }}"
        }
      },
      "id": "6f34f2e9-58cb-4374-a12a-9f3efde7987a",
      "name": "RESOLVE_ORG",
