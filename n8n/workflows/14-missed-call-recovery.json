    {
      "parameters": {
        "jsCode": "const org = $('RESOLVE_ORG').first().json;\nconst first = ($json.name || '').split(' ')[0];\nconst body = `Hi${first ? ' ' + first : ''}, this is ${org.name}. We missed your call. How can we help with your roofing needs? Reply STOP to opt out.`;\nreturn [{ json: { lead_id: $json.lead_id, channel: 'sms', body, kind: 'MISSED_CALL', ai_generated: false } }];"
      },
      "id": "9c520203-cee6-46e5-ad41-86b144e09e99",
